{
	"name": "giant-back-tycoon",
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"Shared": {
				"$path": "src/shared"
			},
			"Assets": {
				"$className": "Folder",
				"$path": "assets"
			},
			"Packages": {
				"$path": {
					"optional": "Packages"
				}
			}
		},
		"ServerScriptService": {
